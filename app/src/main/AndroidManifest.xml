<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.GameZoneTally"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GameZoneTally">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PS5 station widgets -->
        <receiver android:name=".widget.Ps5Station1WidgetReceiver" android:label="PS5 Station 1" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.Ps5Station2WidgetReceiver" android:label="PS5 Station 2" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.Ps5Station3WidgetReceiver" android:label="PS5 Station 3" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.Ps5Station4WidgetReceiver" android:label="PS5 Station 4" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>

        <!-- Xbox station widgets -->
        <receiver android:name=".widget.XboxStation1WidgetReceiver" android:label="Xbox Station 1" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.XboxStation2WidgetReceiver" android:label="Xbox Station 2" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.XboxStation3WidgetReceiver" android:label="Xbox Station 3" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>
        <receiver android:name=".widget.XboxStation4WidgetReceiver" android:label="Xbox Station 4" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/station_widget_info" />
        </receiver>

        <!-- Group total widgets -->
        <receiver android:name=".widget.Ps5TotalWidgetReceiver" android:label="PS5 Total" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/total_widget_info" />
        </receiver>
        <receiver android:name=".widget.XboxTotalWidgetReceiver" android:label="Xbox Total" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/total_widget_info" />
        </receiver>

    </application>

</manifest>
